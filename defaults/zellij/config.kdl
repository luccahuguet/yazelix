default_shell "@yzxShell@"
default_layout "layout"
layout_dir "@layoutDir@"
support_kitty_keyboard_protocol true
pane_frame_style "full"
stacked_pane_list false
theme_dark "ansi"
theme_light "gruvbox-light"

plugins {
    yzpp location="@yzpp@" {
        left_margin_pane_title "sidebar"

        popup_defaults {
            side_margin @defaultPopupSideMargin@
            left_margin 33
            vertical_margin @defaultPopupVerticalMargin@
        }

        popups {
            config {
                command "@yzxConfig@"
                pane_title "config_popup"
                toggle_close_behavior "hide"
            }

            agent {
                command "@yzxAgent@"
                pane_title "agent_popup"
                command_marker "/bin/yzx-agent"
                preserve_terminal_title true
                toggle_close_behavior "hide"
            }

            git {
                command "@git@"
                pane_title "git_popup"
            }

            menu {
                command "@yzxMenu@"
                pane_title "menu_popup"
            }

            screen {
                command "@yzxScreen@"
                pane_title "anima"
                arg_1 "random"
            }

            yazi {
                command "@yzxYazi@"
                pane_title "yazi_popup"
                arg_1 "--yzx-workspace-popup"
                toggle_close_behavior "hide"
                preserve_on_cwd_change true
            }
        }
    }

    yazelix_pane_orchestrator location="@yzxPaneOrchestrator@" {
        screen_saver_enabled false
        quit_on_last_terminal_close true
        popup_plugin_url "yzpp"
        managed_agent_command_marker "/bin/yzx-agent"
    }

    radar location="@zjRadar@" {
        naming "off"
        notify false
        role "view"
    }

    radar_controller location="@zjRadar@" {
        naming "off"
        notify false
        role "controller"
    }
}

load_plugins {
    yzpp
    radar_controller
    // BEGIN NOVA BAR CONTROLLER
__YZX_NOVA_BAR_CONTROLLER__
    // END NOVA BAR CONTROLLER
    yazelix_pane_orchestrator
}

keybinds {
    unbind "Ctrl t"
    locked {
        unbind "Ctrl g"
        bind "Ctrl Alt g" { SwitchToMode "Normal"; }
    }
    pane {
        bind "Ctrl p" { SwitchToMode "Normal"; }
    }
    resize {
        bind "Ctrl n" { SwitchToMode "Normal"; }
    }
    tab {
        bind "n" { NewTab { layout "@layout@"; cwd "__YZX_HOME__"; }; SwitchToMode "Normal"; }
        bind "Ctrl Alt t" { SwitchToMode "Normal"; }
    }
    scroll {
        unbind "Ctrl s"
        bind "Ctrl Alt s" { SwitchToMode "Normal"; }
    }
    search {
        unbind "Ctrl s"
        bind "Ctrl Alt s" { SwitchToMode "Normal"; }
    }
    session {
        unbind "Ctrl o"
        bind "Ctrl Alt o" { SwitchToMode "Normal"; }
    }
    shared_except "locked" {
        unbind "Alt i" "Alt o" "Ctrl g"
        bind "Alt m" { NewPane; }
        bind "Alt Shift T" { NewTab { layout "@layout@"; cwd "__YZX_HOME__"; }; SwitchToMode "Normal"; }
        bind "Alt Shift W" { CloseTab; SwitchToMode "Normal"; }
        bind "Alt Shift Y" {
            MessagePlugin "yazelix_pane_orchestrator" {
                name "toggle_workspace_popup"
                payload "yazi"
            }
        }
        bind "@gitKey@" {
            MessagePlugin "yazelix_pane_orchestrator" {
                name "toggle_workspace_popup"
                payload "git"
            }
        }
        bind "@configKey@" {
            MessagePlugin "yzpp" {
                name "toggle"
                payload "config"
            }
        }
        bind "@agentKey@" {
            MessagePlugin "yazelix_pane_orchestrator" {
                name "toggle_workspace_popup"
                payload "agent"
            }
        }
        bind "@menuKey@" {
            MessagePlugin "yzpp" {
                name "toggle"
                payload "menu"
            }
        }
        bind "@screenKey@" {
            MessagePlugin "yzpp" {
                name "toggle"
                payload "screen"
            }
        }
        bind "Alt h" "Alt Left" { MessagePlugin "yazelix_pane_orchestrator" { name "move_focus_left_or_tab"; }; }
        bind "Alt j" "Alt Down" { MessagePlugin "yazelix_pane_orchestrator" { name "move_focus_down"; }; }
        bind "Alt k" "Alt Up" { MessagePlugin "yazelix_pane_orchestrator" { name "move_focus_up"; }; }
        bind "Alt l" "Alt Right" { MessagePlugin "yazelix_pane_orchestrator" { name "move_focus_right_or_tab"; }; }
        bind "Ctrl Alt n" { MessagePlugin "radar_controller" { name "zj_radar.cmd.v1"; payload "attention-next"; }; }
        bind "Ctrl Alt p" { MessagePlugin "radar_controller" { name "zj_radar.cmd.v1"; payload "attention-prev"; }; }
        bind "Ctrl Tab" { MessagePlugin "radar_controller" { name "zj_radar.cmd.v1"; payload "session-next"; }; }
        bind "Ctrl Shift Tab" { MessagePlugin "radar_controller" { name "zj_radar.cmd.v1"; payload "session-prev"; }; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
        bind "Alt Shift F" { ToggleFocusFullscreen; }
        bind "@sidebarKey@" { MessagePlugin "yazelix_pane_orchestrator" { name "toggle_sidebar"; }; }
        bind "Ctrl Alt g" { SwitchToMode "Locked"; }
        bind "Ctrl q" { Quit; }
        bind "Ctrl Alt h" { MoveTab "Left"; }
        bind "Ctrl Alt j" { MovePane "Down"; }
        bind "Ctrl Alt k" { MovePane "Up"; }
        bind "Ctrl Alt l" { MoveTab "Right"; }
    }
    shared_except "pane" "locked" {
        bind "Ctrl p" { SwitchToMode "Pane"; }
    }
    shared_except "resize" "locked" {
        bind "Ctrl n" { SwitchToMode "Resize"; }
    }
    shared_except "scroll" "locked" {
        unbind "Ctrl s"
        bind "Ctrl Alt s" { SwitchToMode "Scroll"; }
    }
    shared_except "session" "locked" {
        unbind "Ctrl o"
        bind "Ctrl Alt o" { SwitchToMode "Session"; }
    }
    shared_except "tab" "locked" {
        bind "Ctrl Alt t" { SwitchToMode "Tab"; }
    }
    shared_except "move" "locked" {
        unbind "Ctrl h"
    }
}
